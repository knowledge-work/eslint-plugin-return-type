{
  "name": "eslint-plugin-return-type",
  "version": "1.0.34",
  "description": "ESlint plugin to enforces the access of specific return types.",
  "keywords": [
    "access",
    "check",
    "enforce",
    "eslint",
    "eslintplugin",
    "lint",
    "return",
    "rule",
    "type"
  ],
  "license": "MIT",
  "author": "yoshiko-pg",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-return-type.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "jest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preversion": "echo \"Run check for version $npm_package_version\" && run-s clean build test",
    "publish": "npm publish . --access public --registry=https://registry.npmjs.org && git push origin main && git push --tags"
  },
  "dependencies": {
    "@typescript-eslint/utils": "7.18.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/rule-tester": "7.18.0",
    "eslint": "8.57.1",
    "jest": "30.5.2",
    "npm-run-all2": "6.2.6",
    "oxfmt": "0.78.0",
    "rimraf": "5.0.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.20.0"
}
