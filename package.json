{
  "name": "eslint-plugin-return-type",
  "version": "1.1.0",
  "description": "ESlint plugin to enforces the access of specific return types.",
  "keywords": [
    "access",
    "check",
    "enforce",
    "eslint",
    "eslintplugin",
    "lint",
    "return",
    "rule",
    "type"
  ],
  "license": "MIT",
  "author": "yoshiko-pg",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-return-type.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preversion": "echo \"Run check for version $npm_package_version\" && run-s clean build test",
    "release": "git push --follow-tags origin main && pnpm publish --access public --provenance"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/rule-tester": "8.73.0",
    "eslint": "10.15.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.79.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
