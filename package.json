{
  "name": "eslint-plugin-return-type",
  "version": "1.1.0",
  "description": "ESlint plugin to enforces the access of specific return types.",
  "keywords": [
    "access",
    "check",
    "enforce",
    "eslint",
    "eslintplugin",
    "lint",
    "return",
    "rule",
    "type"
  ],
  "license": "MIT",
  "author": "yoshiko-pg",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-return-type.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preversion": "echo \"Run check for version $npm_package_version\" && run-s clean build test",
    "release": "git push --follow-tags origin main && pnpm publish --access public --provenance"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/rule-tester": "8.73.0",
    "eslint": "10.15.0",
    "npm-run-all2": "9.1.0",
    "oxfmt": "0.79.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
